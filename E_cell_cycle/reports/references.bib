	pmid = {20686567},
	pmcid = {PMC3130542},
	keywords = {Phylogeny, Animals, Evolution, Molecular, Humans, Signal Transduction, Cell Cycle, Cell Proliferation, Genomics, Models, Biological, Cell Polarity, Neurons, Genome, Apoptosis, Sequence Analysis, DNA, Cell Adhesion, Immunity, Innate, Genes, Porifera, Phosphotransferases},
