	keywords = {evolutionary biology, Biological Evolution, evolution, multicellularity, Cell Communication, systems biology, Models, Biological, Chemotaxis, Cell Adhesion, collective behaviour, computational biology, none},
	pages = {e56349},
	file = {Full Text:/Users/homapapoli/Zotero/storage/6QT9S2ML/Colizzi et al. - 2020 - Evolution of multicellularity by collective integr.pdf:application/pdf},
}

@article{brunkard_plasmodesmata_2017,
	title = {Plasmodesmata enable multicellularity: new insights into their evolution, biogenesis, and functions in development and immunity},
	volume = {35},
